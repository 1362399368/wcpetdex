# Native/systemd example. Copy to /etc/wechat-pet/server.env (root:petpair, 0640).
# This file contains examples only. Never copy real tokens into source control.
PETPAIR_HOST=127.0.0.1
PETPAIR_PORT=8765
PETPAIR_DB=/var/lib/wechat-pet/petpair.sqlite3
PETPAIR_ADMIN_TOKEN_FILE=/etc/wechat-pet/admin_token
# Alternative for local runs only: PETPAIR_ADMIN_TOKEN=<32+ character secret>
# Set only one of PETPAIR_ADMIN_TOKEN and PETPAIR_ADMIN_TOKEN_FILE.
