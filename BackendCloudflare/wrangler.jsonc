{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wechat-pet-pair",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "vars": { "PERSONAL_MEMBER": "A" },
  "durable_objects": {
    "bindings": [{ "name": "PET_PAIR", "class_name": "PetPairRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PetPairRoom"] }],
  "observability": { "enabled": false }
}
